# NavHub(Rust) 配置示例：复制为 .env 放在程序根目录（NAVHUB_BASE_DIR）下。
# 所有配置项均可用环境变量覆盖，未设置时使用括号内默认值。

# 服务监听地址与端口（0.0.0.0 便于内网访问）
HOST=0.0.0.0
PORT=8100

# 调试模式（生产保持 false）
DEBUG=false

# JWT 密钥：留空则首次启动自动生成并保存到 config/secret.key
# SECRET_KEY=

# 登录令牌有效期（分钟，默认 1440 = 24 小时）
TOKEN_EXPIRE_MINUTES=1440

# 跨域来源（逗号分隔，* 表示允许全部；同源部署无需修改）
CORS_ORIGINS=*

# 登录限速：同一 IP+用户名 连续失败 N 次锁定 M 分钟
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# 图标上传大小上限（MB）
UPLOAD_MAX_MB=2

# 初始管理员账号（仅首次建库时生效，请尽快登录修改密码）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
